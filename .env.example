# Copy this file to .env and fill in real values. Never commit .env — it's gitignored.

# Supabase → Project Settings → API. The anon/public key is safe to expose to the
# browser (it's what Row Level Security is for); it is NOT the service role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secrets (used by the /api serverless functions, never sent to the
# browser). Set these in Vercel's Project → Settings → Environment Variables too.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# 21st.dev MCP server (UI component generation/search). Generate a key from your
# 21st.dev account, then export API_KEY_21ST in your shell before starting Claude
# Code — .mcp.json reads it as ${API_KEY_21ST}. Note: a .env file is NOT read by
# Claude Code for MCP variable expansion; it must be a real environment variable.
API_KEY_21ST=your-21st-dev-api-key
